{
  "name": "Faceless Creator Kit",
  "short_name": "Creator Kit",
  "description": "Plan faceless YouTube videos and make Pinterest pins in bulk. Works offline; your data stays on your device.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1C1A27",
